{
  "expo": {
    "name": "IMPULSO",
    "slug": "impulso",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "scheme": "impulso",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f0f0f"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.menteprospera.impulso",
      "buildNumber": "1",
      "infoPlist": {
        "NSUserTrackingUsageDescription": "O IMPULSO usa estes dados para personalizar as tuas notificacoes de crescimento pessoal.",
        "UIBackgroundModes": ["fetch"]
      }
    },
    "android": {
      "package": "com.menteprospera.impulso",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f0f0f"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "NOTIFICATIONS"
      ]
    },
    "plugins": [
      "expo-notifications",
      "expo-background-fetch"
    ],
    "extra": {
      "eas": {
        "projectId": ""
      }
    }
  }
}
